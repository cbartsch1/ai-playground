// AMT-TEMA Strategy v4
// Auction Market Theory + Triple EMA
// For ES 5m chart | All inputs optimizable
//
// SETUPS:
//   1. IB Breakout + TEMA — trend day entry after IB break
//   2. Value Area Fade + TEMA Slope — mean reversion at VA edges
//   3. TEMA Crossover + Auction Context — trend following outside VA
//
// v4: Real VWAP-based VA (replaces fake typical price proxy)
//     + IB width day-type classification (narrow=trend, wide=rotational)
//     + Volatility regime filter (ATR percentile)
//@version=6
strategy(title="TEST: VA Only", shorttitle="TEST-VA", overlay=true, pyramiding=0, initial_capital=100000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.50, slippage=1, margin_long=5, margin_short=5)

// ══════════════════════════════════════════════════════════════════════════════
// TEMA ENGINE
// ══════════════════════════════════════════════════════════════════════════════

temaFastLen  = input.int(9,  "TEMA Fast",  minval=3,  maxval=21, step=1, group="TEMA")
temaSlowLen  = input.int(21, "TEMA Slow",  minval=13, maxval=55, step=1, group="TEMA")
temaTrendLen = input.int(55, "TEMA Trend", minval=34, maxval=89, step=1, group="TEMA")

temaCalc(src, len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    3 * e1 - 3 * e2 + e3

temaFast  = temaCalc(close, temaFastLen)
temaSlow  = temaCalc(close, temaSlowLen)
temaTrend = temaCalc(close, temaTrendLen)

temaBullish  = temaFast > temaSlow
temaBearish  = temaFast < temaSlow
temaSlope    = temaFast - temaFast[3]
slopeRising  = temaSlope > temaSlope[3]
slopeFalling = temaSlope < temaSlope[3]
trendUp      = close > temaTrend
trendDown    = close < temaTrend

// ══════════════════════════════════════════════════════════════════════════════
// SESSION & TIME (Eastern Time)
// ══════════════════════════════════════════════════════════════════════════════

etHour   = hour(time, "America/New_York")
etMinute = minute(time, "America/New_York")
etTime   = etHour * 100 + etMinute

rthStart = 930
rthEnd   = 1600
ibEndTime = 1030

tradeStart  = input.int(1035, "Trade Start (ET)", minval=1030, maxval=1100, step=5, group="Session")
tradeEnd    = input.int(1530, "Trade End (ET)",   minval=1430, maxval=1555, step=5, group="Session")
flattenTime = input.int(1555, "Flatten Time (ET)", minval=1530, maxval=1600, step=5, group="Session")

isRTH           = etTime >= rthStart and etTime < rthEnd
isIBPeriod      = etTime >= rthStart and etTime < ibEndTime
isTradingWindow = etTime >= tradeStart and etTime < tradeEnd
newRTH          = isRTH and not isRTH[1]

// ══════════════════════════════════════════════════════════════════════════════
// INITIAL BALANCE — First 60 min of RTH (9:30-10:30 ET)
// ══════════════════════════════════════════════════════════════════════════════

var float ibHigh = na
var float ibLow  = na
var bool  ibDone = false

if newRTH
    ibHigh := high
    ibLow  := low
    ibDone := false
else if isIBPeriod
    ibHigh := math.max(nz(ibHigh, high), high)
    ibLow  := math.min(nz(ibLow, low), low)
else if not ibDone and isRTH and not isIBPeriod
    ibDone := true

ibRange = nz(ibHigh - ibLow, 0)
ibMid   = nz((ibHigh + ibLow) / 2, close)

// ══════════════════════════════════════════════════════════════════════════════
// IB WIDTH DAY-TYPE CLASSIFICATION
// Compare today's IB to rolling average to classify day type
// Narrow IB = trend day potential → favor IB breakout
// Wide IB = rotational day → favor VA fade
// ══════════════════════════════════════════════════════════════════════════════

ibAvgLen      = input.int(20, "IB Average Length (days)", minval=5, maxval=50, step=5, group="Day Type")
ibNarrowRatio = input.float(0.8, "Narrow IB Ratio", minval=0.5, maxval=1.0, step=0.1, group="Day Type")
ibWideRatio   = input.float(1.2, "Wide IB Ratio",   minval=1.0, maxval=2.0, step=0.1, group="Day Type")
useDayType    = input.bool(true, "Enable Day Type Filter", group="Day Type")

// Rolling EMA of IB range (updates once per day when IB completes)
var float ibRangeAvg = na
if ibDone and not ibDone[1]
    ibAlpha = 2.0 / (ibAvgLen + 1.0)
    ibRangeAvg := na(ibRangeAvg) ? ibRange : ibRangeAvg * (1.0 - ibAlpha) + ibRange * ibAlpha

ibRatio     = ibRangeAvg > 0 ? ibRange / ibRangeAvg : 1.0
isNarrowIB  = ibRatio < ibNarrowRatio
isWideIB    = ibRatio > ibWideRatio
isNormalIB  = not isNarrowIB and not isWideIB

// Day type labels for dashboard
dayTypeStr  = isNarrowIB ? "NARROW" : isWideIB ? "WIDE" : "NORMAL"

// ══════════════════════════════════════════════════════════════════════════════
// PREVIOUS DAY VALUE AREA — VWAP-BASED (replaces fake typical price proxy)
// Tracks RTH session VWAP and price stdev, stores at session change
// VWAP = volume-weighted fair value (much better POC proxy)
// Stdev from VWAP = natural VA width from actual price dispersion
// ══════════════════════════════════════════════════════════════════════════════

vaStdevMult = input.float(1.0, "VA Width (stdev mult)", minval=0.5, maxval=2.0, step=0.25, group="Value Area")

// Running VWAP components for RTH session
var float rthVwapSum = 0.0
var float rthVolSum  = 0.0
var float rthSqDev   = 0.0
var int   rthBars    = 0

// Previous session stored levels
var float prevPOC = na
var float prevVAH = na
var float prevVAL = na
var float prevSessionStdev = na

// Track RTH session high/low
var float rthHi = na
var float rthLo = na

if newRTH
    // Store previous RTH session's VWAP as POC
    if rthVolSum > 0
        sessionVWAP = rthVwapSum / rthVolSum
        sessionStdev = rthBars > 1 ? math.sqrt(rthSqDev / rthBars) : 0.0
        prevPOC := sessionVWAP
        prevSessionStdev := sessionStdev
        // VA = VWAP ± stdev (captures ~68% of price activity centered on volume)
        prevVAH := sessionVWAP + sessionStdev * vaStdevMult
        prevVAL := sessionVWAP - sessionStdev * vaStdevMult
    // Reset for new session
    rthVwapSum := 0.0
    rthVolSum  := 0.0
    rthSqDev   := 0.0
    rthBars    := 0
    rthHi      := high
    rthLo      := low

if isRTH
    rthVwapSum += hlc3 * volume
    rthVolSum  += volume
    rthHi      := math.max(nz(rthHi, high), high)
    rthLo      := math.min(nz(rthLo, low), low)
    // Running stdev: accumulate squared deviation from running VWAP
    if rthVolSum > 0
        currentVWAP = rthVwapSum / rthVolSum
        rthSqDev += math.pow(close - currentVWAP, 2)
        rthBars  += 1

// Fallback if no previous data
prevPOCVal = nz(prevPOC, close)
prevVAHVal = nz(prevVAH, close + 10)
prevVALVal = nz(prevVAL, close - 10)

aboveVA  = close > prevVAHVal
belowVA  = close < prevVALVal
insideVA = not aboveVA and not belowVA

// ══════════════════════════════════════════════════════════════════════════════
// VWAP (current session)
// ══════════════════════════════════════════════════════════════════════════════

vwapVal = ta.vwap(hlc3)

// ══════════════════════════════════════════════════════════════════════════════
// ATR & RISK
// ══════════════════════════════════════════════════════════════════════════════

atrLen = input.int(14, "ATR Length", minval=7, maxval=21, step=1, group="Risk")
atrVal = ta.atr(atrLen)
tick   = syminfo.mintick

// ══════════════════════════════════════════════════════════════════════════════
// VOLATILITY REGIME FILTER
// Skip trading when volatility is abnormally low (dead market, no edge)
// or abnormally high (chaotic, stops get blown)
// ══════════════════════════════════════════════════════════════════════════════

useVolFilter  = input.bool(true, "Enable Volatility Filter", group="Volatility")
atrAvgLen     = input.int(50, "ATR Average Length", minval=20, maxval=100, step=10, group="Volatility")
volLowRatio   = input.float(0.5, "Min Vol Ratio", minval=0.2, maxval=0.8, step=0.1, group="Volatility")
volHighRatio  = input.float(2.0, "Max Vol Ratio", minval=1.5, maxval=3.0, step=0.5, group="Volatility")

atrAvg    = ta.sma(atrVal, atrAvgLen)
volRatio  = atrAvg > 0 ? atrVal / atrAvg : 1.0
volOK     = not useVolFilter or (volRatio >= volLowRatio and volRatio <= volHighRatio)

// ══════════════════════════════════════════════════════════════════════════════
// COOLDOWN
// ══════════════════════════════════════════════════════════════════════════════

cooldownBars = input.int(4, "Cooldown Bars", minval=1, maxval=15, step=1, group="Risk")

var int barsSinceExit = 100
if strategy.position_size == 0 and strategy.position_size[1] != 0
    barsSinceExit := 0
else if strategy.position_size == 0
    barsSinceExit += 1
pastCooldown = barsSinceExit >= cooldownBars

// ══════════════════════════════════════════════════════════════════════════════
// RTH OPEN TRACKING
// ══════════════════════════════════════════════════════════════════════════════

var float rthOpen = na
if newRTH
    rthOpen := open

// ══════════════════════════════════════════════════════════════════════════════
// SETUP 1: IB BREAKOUT + TEMA
// Day type filter: prefer narrow IB days (trend potential)
// ══════════════════════════════════════════════════════════════════════════════

useIBBreak     = input.bool(false, "Enable IB Breakout", group="IB Breakout")
useTrendFilter = input.bool(true, "Require TEMA Trend Filter", group="IB Breakout")
minIBRange     = input.float(5.0,  "Min IB Range (pts)", minval=1,  maxval=15, step=1, group="IB Breakout")
maxIBRange     = input.float(25.0, "Max IB Range (pts)", minval=10, maxval=50, step=5, group="IB Breakout")
ibStopType     = input.string("IB Mid", "Stop Placement", options=["IB Mid", "IB Edge", "ATR"], group="IB Breakout")
maxIBTrades    = input.int(1, "Max IB Trades/Dir/Day", minval=1, maxval=3, step=1, group="IB Breakout")

ibValid = ibRange >= minIBRange and ibRange <= maxIBRange

ibCrossUp   = ibDone and ta.crossover(close, ibHigh)
ibCrossDown = ibDone and ta.crossunder(close, ibLow)

ibTrendOK_L = not useTrendFilter or trendUp
ibTrendOK_S = not useTrendFilter or trendDown

// Day type gate: skip IB breakout on wide IB days (rotational, breakouts fail)
ibDayTypeOK = not useDayType or not isWideIB

var int ibTradesL = 0
var int ibTradesS = 0
if newRTH
    ibTradesL := 0
    ibTradesS := 0

ibLongSignal  = useIBBreak and ibCrossUp and temaBullish and ibTrendOK_L and ibValid and ibDayTypeOK and volOK and isTradingWindow and pastCooldown and strategy.position_size == 0 and ibTradesL < maxIBTrades
ibShortSignal = useIBBreak and ibCrossDown and temaBearish and ibTrendOK_S and ibValid and ibDayTypeOK and volOK and isTradingWindow and pastCooldown and strategy.position_size == 0 and ibTradesS < maxIBTrades

if ibLongSignal
    ibTradesL += 1
if ibShortSignal
    ibTradesS += 1

ibSL_L = ibStopType == "IB Mid" ? ibMid : ibStopType == "IB Edge" ? ibLow : close - atrVal * 1.5
ibTP_L = close + ibRange
ibSL_S = ibStopType == "IB Mid" ? ibMid : ibStopType == "IB Edge" ? ibHigh : close + atrVal * 1.5
ibTP_S = close - ibRange

// ══════════════════════════════════════════════════════════════════════════════
// SETUP 2: VALUE AREA FADE + TEMA SLOPE
// Day type filter: prefer wide/normal IB days (rotational, fades work)
// ══════════════════════════════════════════════════════════════════════════════

useVAFade   = input.bool(true, "Enable VA Fade", group="VA Fade")
vaBuffer    = input.float(2.0, "VA Touch Buffer (ticks)", minval=0, maxval=8, step=1, group="VA Fade")
vaStopMult  = input.float(0.5, "VA Stop (ATR mult)", minval=0.3, maxval=2.0, step=0.1, group="VA Fade")
vaMinRR     = input.float(1.0, "VA Min R:R", minval=0.5, maxval=3.0, step=0.5, group="VA Fade")
maxVATrades = input.int(1, "Max VA Trades/Dir/Day", minval=1, maxval=3, step=1, group="VA Fade")

bufferPts = vaBuffer * tick

vaTouchLow  = low <= prevVALVal + bufferPts and close > prevVALVal
vaTouchHigh = high >= prevVAHVal - bufferPts and close < prevVAHVal

vaSL_L = prevVALVal - atrVal * vaStopMult
vaTP_L = prevPOCVal
vaSL_S = prevVAHVal + atrVal * vaStopMult
vaTP_S = prevPOCVal

vaReward_L = math.abs(vaTP_L - close)
vaRisk_L   = math.abs(close - vaSL_L)
vaReward_S = math.abs(close - vaTP_S)
vaRisk_S   = math.abs(vaSL_S - close)
vaRROK_L   = vaRisk_L > 0 and vaReward_L / vaRisk_L >= vaMinRR
vaRROK_S   = vaRisk_S > 0 and vaReward_S / vaRisk_S >= vaMinRR

// Day type gate: skip VA fade on narrow IB days (trending, fades get run over)
vaDayTypeOK = not useDayType or not isNarrowIB

var int vaTradesL = 0
var int vaTradesS = 0
if newRTH
    vaTradesL := 0
    vaTradesS := 0

vaLongSignal  = useVAFade and vaTouchLow and slopeRising and vaRROK_L and vaDayTypeOK and volOK and isTradingWindow and pastCooldown and strategy.position_size == 0 and vaTradesL < maxVATrades
vaShortSignal = useVAFade and vaTouchHigh and slopeFalling and vaRROK_S and vaDayTypeOK and volOK and isTradingWindow and pastCooldown and strategy.position_size == 0 and vaTradesS < maxVATrades

if vaLongSignal
    vaTradesL += 1
if vaShortSignal
    vaTradesS += 1

// ══════════════════════════════════════════════════════════════════════════════
// SETUP 3: TEMA CROSSOVER + AUCTION CONTEXT
// Pure trend-following: TEMA(9) crosses TEMA(21) with TEMA(55) trend filter
// Auction filter: only take signals OUTSIDE prior day's VA
// ══════════════════════════════════════════════════════════════════════════════

useTemaXover   = input.bool(false, "Enable TEMA Crossover", group="TEMA Crossover")
txStopMult     = input.float(1.5, "TX Stop (ATR mult)", minval=0.5, maxval=3.0, step=0.5, group="TEMA Crossover")
txTrailMult    = input.float(1.0, "TX Trail (ATR mult)", minval=0.5, maxval=3.0, step=0.5, group="TEMA Crossover")
txTargetMult   = input.float(3.0, "TX Target (ATR mult)", minval=1.0, maxval=5.0, step=0.5, group="TEMA Crossover")
maxTXTrades    = input.int(2, "Max TX Trades/Dir/Day", minval=1, maxval=4, step=1, group="TEMA Crossover")
txInsideVA     = input.bool(false, "Allow Inside VA", group="TEMA Crossover")

// TEMA crossover signals
temaCrossUp   = ta.crossover(temaFast, temaSlow)
temaCrossDown = ta.crossunder(temaFast, temaSlow)

// Auction context: price must be outside prior VA (initiative/trending)
txContextOK_L = txInsideVA or aboveVA
txContextOK_S = txInsideVA or belowVA

var int txTradesL = 0
var int txTradesS = 0
if newRTH
    txTradesL := 0
    txTradesS := 0

txLongSignal  = useTemaXover and temaCrossUp and trendUp and txContextOK_L and volOK and isTradingWindow and pastCooldown and strategy.position_size == 0 and txTradesL < maxTXTrades
txShortSignal = useTemaXover and temaCrossDown and trendDown and txContextOK_S and volOK and isTradingWindow and pastCooldown and strategy.position_size == 0 and txTradesS < maxTXTrades

if txLongSignal
    txTradesL += 1
if txShortSignal
    txTradesS += 1

txSL_L = close - atrVal * txStopMult
txTP_L = close + atrVal * txTargetMult
txSL_S = close + atrVal * txStopMult
txTP_S = close - atrVal * txTargetMult

// ══════════════════════════════════════════════════════════════════════════════
// EXECUTION
// ══════════════════════════════════════════════════════════════════════════════

// Setup 1: IB Breakout
if ibLongSignal
    strategy.entry("IB_L", strategy.long)
    strategy.exit("IB_LX", "IB_L", stop=ibSL_L, limit=ibTP_L)

if ibShortSignal
    strategy.entry("IB_S", strategy.short)
    strategy.exit("IB_SX", "IB_S", stop=ibSL_S, limit=ibTP_S)

// Setup 2: VA Fade
if vaLongSignal
    strategy.entry("VA_L", strategy.long)
    strategy.exit("VA_LX", "VA_L", stop=vaSL_L, limit=vaTP_L)

if vaShortSignal
    strategy.entry("VA_S", strategy.short)
    strategy.exit("VA_SX", "VA_S", stop=vaSL_S, limit=vaTP_S)

// Setup 3: TEMA Crossover
if txLongSignal
    strategy.entry("TX_L", strategy.long)
    strategy.exit("TX_LX", "TX_L", stop=txSL_L, limit=txTP_L, trail_offset=txTrailMult * atrVal / tick, trail_points=txTrailMult * atrVal / tick)

if txShortSignal
    strategy.entry("TX_S", strategy.short)
    strategy.exit("TX_SX", "TX_S", stop=txSL_S, limit=txTP_S, trail_offset=txTrailMult * atrVal / tick, trail_points=txTrailMult * atrVal / tick)

// Session flatten
if etTime >= flattenTime and strategy.position_size != 0
    strategy.close_all("RTH End")

// ══════════════════════════════════════════════════════════════════════════════
// VISUALS
// ══════════════════════════════════════════════════════════════════════════════

// TEMA lines
plot(temaFast,  "TEMA Fast",  color.new(color.lime, 0), 1)
plot(temaSlow,  "TEMA Slow",  color.new(color.orange, 0), 1)
plot(temaTrend, "TEMA Trend", color.new(color.yellow, 0), 2)

// IB levels
plot(ibDone ? ibHigh : na, "IB High", color.new(color.blue, 30), 2, plot.style_stepline)
plot(ibDone ? ibLow  : na, "IB Low",  color.new(color.blue, 30), 2, plot.style_stepline)
plot(ibDone ? ibMid  : na, "IB Mid",  color.new(color.blue, 70), 1, plot.style_stepline)

// Previous day Value Area (now VWAP-based)
plot(prevVAHVal, "Prev VAH", color.new(color.red, 40), 1, plot.style_stepline)
plot(prevVALVal, "Prev VAL", color.new(color.green, 40), 1, plot.style_stepline)
plot(prevPOCVal, "Prev POC", color.new(color.white, 50), 1, plot.style_stepline)

// VWAP
plot(vwapVal, "VWAP", color.new(color.purple, 20), 2)

// Entry signals
plotshape(ibLongSignal,    "IB Long",   shape.triangleup,    location.belowbar, color.lime,    size=size.small)
plotshape(ibShortSignal,   "IB Short",  shape.triangledown,  location.abovebar, color.red,     size=size.small)
plotshape(vaLongSignal,    "VA Long",   shape.circle,        location.belowbar, color.green,   size=size.small)
plotshape(vaShortSignal,   "VA Short",  shape.circle,        location.abovebar, color.orange,  size=size.small)
plotshape(txLongSignal,    "TX Long",   shape.diamond,       location.belowbar, color.aqua,    size=size.small)
plotshape(txShortSignal,   "TX Short",  shape.diamond,       location.abovebar, color.fuchsia, size=size.small)

// Background — highlight day type
bgcolor(not isRTH ? color.new(color.gray, 95) : isIBPeriod ? color.new(color.blue, 95) : not isTradingWindow ? color.new(color.gray, 97) : isNarrowIB and useDayType ? color.new(color.lime, 97) : isWideIB and useDayType ? color.new(color.orange, 97) : na)

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

var table t = table.new(position.top_right, 2, 16, color.new(color.black, 75))
if barstate.islast
    table.cell(t, 0, 0, "AMT-TEMA v4", text_color=color.black, bgcolor=color.orange)
    table.cell(t, 1, 0, "", bgcolor=color.orange)

    table.cell(t, 0, 1, "TEMA", text_color=color.white)
    table.cell(t, 1, 1, temaBullish ? "BULL" : "BEAR", text_color=temaBullish ? color.green : color.red)

    table.cell(t, 0, 2, "Trend", text_color=color.white)
    table.cell(t, 1, 2, trendUp ? "UP" : "DOWN", text_color=trendUp ? color.green : color.red)

    table.cell(t, 0, 3, "Slope", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(temaSlope, "#.##"), text_color=temaSlope > 0 ? color.green : color.red)

    table.cell(t, 0, 4, "IB Range", text_color=color.white)
    ibRText = ibDone ? str.tostring(ibRange, "#.##") + "pt" : "FORMING"
    ibRColor = ibDone ? (ibValid ? color.green : color.orange) : color.yellow
    table.cell(t, 1, 4, ibRText, text_color=ibRColor)

    table.cell(t, 0, 5, "Day Type", text_color=color.white)
    dtColor = isNarrowIB ? color.lime : isWideIB ? color.orange : color.white
    dtText = dayTypeStr + " (" + str.tostring(ibRatio, "#.##") + "x)"
    table.cell(t, 1, 5, dtText, text_color=dtColor)

    table.cell(t, 0, 6, "IB Status", text_color=color.white)
    ibSText = not ibDone ? "---" : close > ibHigh ? "ABOVE" : close < ibLow ? "BELOW" : "INSIDE"
    ibSColor = not ibDone ? color.gray : close > ibHigh ? color.green : close < ibLow ? color.red : color.white
    table.cell(t, 1, 6, ibSText, text_color=ibSColor)

    table.cell(t, 0, 7, "vs VA", text_color=color.white)
    vaText = aboveVA ? "ABOVE" : belowVA ? "BELOW" : "INSIDE"
    vaColor2 = aboveVA ? color.green : belowVA ? color.red : color.white
    table.cell(t, 1, 7, vaText, text_color=vaColor2)

    table.cell(t, 0, 8, "POC (VWAP)", text_color=color.white)
    table.cell(t, 1, 8, str.tostring(prevPOCVal, "#.##"), text_color=color.white)

    table.cell(t, 0, 9, "Vol Regime", text_color=color.white)
    volText = str.tostring(volRatio, "#.##") + "x"
    volColor = volOK ? color.green : color.red
    table.cell(t, 1, 9, volText, text_color=volColor)

    table.cell(t, 0, 10, "TX Context", text_color=color.white)
    txCtxText = aboveVA ? "ABOVE VA" : belowVA ? "BELOW VA" : "INSIDE VA"
    txCtxColor = (aboveVA or belowVA) ? color.green : color.orange
    table.cell(t, 1, 10, txCtxText, text_color=txCtxColor)

    table.cell(t, 0, 11, "Session", text_color=color.white)
    sessText = isIBPeriod ? "IB" : isTradingWindow ? "ACTIVE" : isRTH ? "RTH" : "CLOSED"
    sessColor = isTradingWindow ? color.green : isIBPeriod ? color.yellow : isRTH ? color.white : color.gray
    table.cell(t, 1, 11, sessText, text_color=sessColor)

    table.cell(t, 0, 12, "Cooldown", text_color=color.white)
    table.cell(t, 1, 12, str.tostring(barsSinceExit) + "/" + str.tostring(cooldownBars), text_color=pastCooldown ? color.green : color.red)

    table.cell(t, 0, 13, "ATR", text_color=color.white)
    table.cell(t, 1, 13, str.tostring(atrVal / tick, "#.#") + "t", text_color=color.aqua)

    table.cell(t, 0, 14, "Trades Today", text_color=color.white)
    table.cell(t, 1, 14, "IB:" + str.tostring(ibTradesL + ibTradesS) + " VA:" + str.tostring(vaTradesL + vaTradesS) + " TX:" + str.tostring(txTradesL + txTradesS), text_color=color.aqua)

    table.cell(t, 0, 15, "Capital", text_color=color.white)
    table.cell(t, 1, 15, "$" + str.tostring(strategy.equity, "#,###"), text_color=strategy.equity >= 100000 ? color.green : color.red)
