// Hybrid Scalper-Ichimoku Strategy v7
// Entry: Direct Structure Break (v4 logic — best win rate)
// Trade reduction: Higher lookback/cooldown + EMA alignment gate (from v5)
// Exit: Fixed SL/TP + optional smart Kijun trailing
// For ES 5m chart | All inputs optimizable
// v7: v4 direct breakout + v5 trade filters, no pullback, no ATR gate
//@version=6
strategy(title="Hybrid Scalper-Ichimoku", shorttitle="HYBRID-v7", overlay=true, pyramiding=0, initial_capital=100000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.50, slippage=1, margin_long=5, margin_short=5)

// ══════════════════════════════════════════════════════════════════════════════
// MODE SELECTOR
// ══════════════════════════════════════════════════════════════════════════════

modeInput = input.string("Standard", "Trading Mode", options=["Conservative", "Standard", "Aggressive"], group="Mode")
isConservative = modeInput == "Conservative"
isAggressive   = modeInput == "Aggressive"

// ══════════════════════════════════════════════════════════════════════════════
// HTF BIAS
// ══════════════════════════════════════════════════════════════════════════════

htfEmaLen  = input.int(20, "HTF EMA Length", minval=10, maxval=50, step=5, group="HTF Bias")
useHTF     = input.bool(true, "Enable HTF Filter", group="HTF Bias")
htfEmaRaw  = request.security(syminfo.tickerid, "15", ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
htfEma     = nz(htfEmaRaw, close)
htfBullish = close > htfEma
htfBearish = close < htfEma

// ══════════════════════════════════════════════════════════════════════════════
// ICHIMOKU
// ══════════════════════════════════════════════════════════════════════════════

tenkanLen    = input.int(9,  "Tenkan",       minval=7,  maxval=13, step=2, group="Ichimoku")
kijunLen     = input.int(26, "Kijun",        minval=18, maxval=34, step=4, group="Ichimoku")
senkouBLen   = input.int(52, "Senkou B",     minval=36, maxval=68, step=8, group="Ichimoku")
displacement = input.int(26, "Displacement", minval=18, maxval=34, step=4, group="Ichimoku")

tenkan  = (ta.highest(high, tenkanLen) + ta.lowest(low, tenkanLen)) / 2
kijun   = (ta.highest(high, kijunLen) + ta.lowest(low, kijunLen)) / 2
senkouA = (tenkan + kijun) / 2
senkouB = (ta.highest(high, senkouBLen) + ta.lowest(low, senkouBLen)) / 2

cloudTop       = math.max(senkouA, senkouB)
cloudBottom    = math.min(senkouA, senkouB)
tick           = syminfo.mintick
cloudThickness = (cloudTop - cloudBottom) / tick
cloudBullish   = senkouA > senkouB
cloudBearish   = senkouA < senkouB
chikouAbove    = close > close[displacement]
chikouBelow    = close < close[displacement]

// ══════════════════════════════════════════════════════════════════════════════
// ENTRY TRIGGER — Direct Structure Break
// ══════════════════════════════════════════════════════════════════════════════

swingLen     = input.int(8, "Structure Lookback", minval=3, maxval=15, step=1, group="Entry")
cooldownBars = input.int(6, "Cooldown Bars", minval=1, maxval=15, step=1, group="Entry")
minCandleStr = input.float(0.6, "Min Candle Strength", minval=0.3, maxval=0.9, step=0.05, group="Entry")

emaFast = input.int(5, "Fast EMA", minval=3, maxval=8, step=1, group="Entry")
emaSlow = input.int(10, "Slow EMA", minval=8, maxval=15, step=1, group="Entry")
ema5  = ta.ema(close, emaFast)
ema10 = ta.ema(close, emaSlow)

recentHigh = ta.highest(high, swingLen)[1]
recentLow  = ta.lowest(low, swingLen)[1]

structBreakLong  = not na(recentHigh) and close > recentHigh
structBreakShort = not na(recentLow) and close < recentLow

// Candle strength
candleRange      = high - low
candleStrL       = candleRange > 0 ? (close - low) / candleRange : 0.0
candleStrS       = candleRange > 0 ? (high - close) / candleRange : 0.0
strongBullCandle = candleStrL >= minCandleStr
strongBearCandle = candleStrS >= minCandleStr

// Cooldown
var int barsSinceExit = 100
if strategy.position_size == 0 and strategy.position_size[1] != 0
    barsSinceExit := 0
else if strategy.position_size == 0
    barsSinceExit += 1
pastCooldown = barsSinceExit >= cooldownBars

// Entry trigger: direct breakout + strong candle + cooldown
longTrigger  = structBreakLong and strongBullCandle and pastCooldown
shortTrigger = structBreakShort and strongBearCandle and pastCooldown

// ══════════════════════════════════════════════════════════════════════════════
// EXITS
// ══════════════════════════════════════════════════════════════════════════════

slTicks       = input.float(8.0, "Stop Loss Ticks", minval=4, maxval=16, step=2, group="Exits")
tpTicks       = input.float(16.0, "Take Profit Ticks", minval=8, maxval=40, step=4, group="Exits")
useKijunTrail = input.bool(false, "Use Kijun Trailing Stop", group="Exits")
kijunBuffer   = input.float(2.0, "Kijun Buffer (ticks)", minval=0, maxval=6, step=1, group="Exits")

modeSL = isConservative ? slTicks - 2 : isAggressive ? slTicks + 2 : slTicks
modeTP = isConservative ? tpTicks - 4 : isAggressive ? tpTicks + 4 : tpTicks

slPoints = modeSL * tick
tpPoints = modeTP * tick

// ══════════════════════════════════════════════════════════════════════════════
// GATES
// ══════════════════════════════════════════════════════════════════════════════

// EMA Alignment (v5 addition — longs need fast > slow)
useEmaAlign = input.bool(true, "Enable EMA Alignment", group="Gates")

// RSI
rsiLen        = input.int(7, "RSI Length", minval=5, maxval=14, step=1, group="RSI")
rsiLongEntry  = input.int(55, "RSI Long Min", minval=40, maxval=65, step=5, group="RSI")
rsiShortEntry = input.int(45, "RSI Short Max", minval=35, maxval=60, step=5, group="RSI")
useRSI        = input.bool(true, "Enable RSI Filter", group="RSI")
rsi           = ta.rsi(close, rsiLen)

// VWAP
useVWAP = input.bool(true, "Enable VWAP Filter", group="Gates")
vwapRaw = ta.vwap(hlc3)
vwapVal = nz(vwapRaw, close)

// Cloud alignment
useCloud = input.bool(false, "Enable Cloud Alignment", group="Gates")
priceAboveCloud = close > cloudTop
priceBelowCloud = close < cloudBottom

// Cloud thickness
useCloudThick = input.bool(false, "Enable Cloud Thickness", group="Gates")
minCloudTicks = input.float(3.0, "Min Cloud Ticks", minval=2, maxval=10, step=1, group="Gates")
cloudThickEnough = cloudThickness >= minCloudTicks

// Chikou
useChikou = input.bool(false, "Enable Chikou", group="Gates")

// Volume
useVolFilter = input.bool(true, "Enable Volume Filter", group="Gates")
volLen       = input.int(20, "Volume MA Length", minval=10, maxval=50, step=5, group="Gates")
volMult      = input.float(0.8, "Volume Min Multiplier", minval=0.5, maxval=1.5, step=0.1, group="Gates")
avgVol       = ta.sma(volume, volLen)
volOK        = not na(avgVol) and volume >= avgVol * volMult

// Session
useSession = input.bool(true, "Enable Session Filter", group="Session")
sessStart  = input.int(940,  "Morning Start", minval=900, maxval=1000, step=5, group="Session")
sessEnd    = input.int(1130, "Morning End", minval=1030, maxval=1200, step=15, group="Session")
sessStart2 = input.int(1400, "Afternoon Start", minval=1330, maxval=1430, step=15, group="Session")
sessEnd2   = input.int(1530, "Afternoon End", minval=1500, maxval=1600, step=15, group="Session")
timeNow    = hour * 100 + minute
inMorning  = timeNow >= sessStart and timeNow < sessEnd
inAfternoon = timeNow >= sessStart2 and timeNow < sessEnd2
inSession  = not useSession or inMorning or inAfternoon

// ══════════════════════════════════════════════════════════════════════════════
// ENTRY SIGNALS
// ══════════════════════════════════════════════════════════════════════════════

passHTF_L      = not useHTF or htfBullish
passVWAP_L     = not useVWAP or close > vwapVal
passCloud_L    = not useCloud or (priceAboveCloud and cloudBullish)
passThick_L    = not useCloudThick or cloudThickEnough
passChi_L      = not useChikou or chikouAbove
passRSI_L      = not useRSI or rsi > rsiLongEntry
passVol_L      = not useVolFilter or volOK
passEmaAlign_L = not useEmaAlign or (ema5 > ema10)

longSignal = longTrigger and passHTF_L and passVWAP_L and passCloud_L and passThick_L and passChi_L and passRSI_L and passVol_L and passEmaAlign_L and inSession and strategy.position_size == 0

passHTF_S      = not useHTF or htfBearish
passVWAP_S     = not useVWAP or close < vwapVal
passCloud_S    = not useCloud or (priceBelowCloud and cloudBearish)
passThick_S    = not useCloudThick or cloudThickEnough
passChi_S      = not useChikou or chikouBelow
passRSI_S      = not useRSI or rsi < rsiShortEntry
passVol_S      = not useVolFilter or volOK
passEmaAlign_S = not useEmaAlign or (ema5 < ema10)

shortSignal = shortTrigger and passHTF_S and passVWAP_S and passCloud_S and passThick_S and passChi_S and passRSI_S and passVol_S and passEmaAlign_S and inSession and strategy.position_size == 0

// Track entry stop level for smart Kijun trail
var float entryStopLevel = na
var float entryTPLevel   = na

// ══════════════════════════════════════════════════════════════════════════════
// EXECUTION
// ══════════════════════════════════════════════════════════════════════════════

if longSignal
    entryStopLevel := close - slPoints
    entryTPLevel   := close + tpPoints
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", stop=entryStopLevel, limit=entryTPLevel)

if shortSignal
    entryStopLevel := close + slPoints
    entryTPLevel   := close - tpPoints
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", stop=entryStopLevel, limit=entryTPLevel)

// Smart Kijun trail: only move stop if Kijun is BETTER than the original entry stop
if useKijunTrail and strategy.position_size > 0 and not na(entryStopLevel)
    kijunStopPrice = kijun - kijunBuffer * tick
    effectiveStop = math.max(kijunStopPrice, entryStopLevel)
    strategy.exit("LX", "L", stop=effectiveStop, limit=entryTPLevel)

if useKijunTrail and strategy.position_size < 0 and not na(entryStopLevel)
    kijunStopPrice = kijun + kijunBuffer * tick
    effectiveStop = math.min(kijunStopPrice, entryStopLevel)
    strategy.exit("SX", "S", stop=effectiveStop, limit=entryTPLevel)

// Clear entry levels when flat
if strategy.position_size == 0
    entryStopLevel := na
    entryTPLevel   := na

if useSession
    amFlattenTime = sessEnd - 5
    pmFlattenTime = sessEnd2 - 5
    if (timeNow >= amFlattenTime and timeNow < sessStart2) or timeNow >= pmFlattenTime
        if strategy.position_size != 0
            strategy.close_all("Session End")

// ══════════════════════════════════════════════════════════════════════════════
// VISUALS
// ══════════════════════════════════════════════════════════════════════════════

plot(ema5, "EMA Fast", color.green, 1)
plot(ema10, "EMA Slow", color.red, 1)
plot(htfEma, "15m EMA", color.yellow, 2)
plot(tenkan, "Tenkan", color.new(color.blue, 30), 1)
plot(kijun, "Kijun", color.new(color.red, 30), 2)

p1 = plot(senkouA[displacement], "Senkou A", color.new(color.green, 60), 1)
p2 = plot(senkouB[displacement], "Senkou B", color.new(color.red, 60), 1)
fill(p1, p2, color=senkouA[displacement] > senkouB[displacement] ? color.new(color.green, 85) : color.new(color.red, 85))

plot(close, "Chikou", color.new(color.purple, 30), 1, offset=-displacement)
plot(vwapVal, "VWAP", color.white, 1)
plot(recentHigh, "Swing High", color.new(color.green, 50), 1, plot.style_stepline)
plot(recentLow, "Swing Low", color.new(color.red, 50), 1, plot.style_stepline)

plotshape(structBreakLong, "Break Up", shape.flag, location.abovebar, color.new(color.green, 40), size=size.tiny)
plotshape(structBreakShort, "Break Down", shape.flag, location.belowbar, color.new(color.red, 40), size=size.tiny)
plotshape(longSignal, "Long Entry", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortSignal, "Short Entry", shape.triangledown, location.abovebar, color.red, size=size.small)

bgcolor(not inSession ? color.new(color.gray, 90) : htfBullish ? color.new(color.green, 95) : htfBearish ? color.new(color.red, 95) : na)

// ══════════════════════════════════════════════════════════════════════════════
// INFO PANEL
// ══════════════════════════════════════════════════════════════════════════════

var table t = table.new(position.top_right, 2, 14, color.new(color.black, 75))
if barstate.islast
    modeColor = isConservative ? color.blue : isAggressive ? color.red : color.orange
    table.cell(t, 0, 0, "HYBRID v7", text_color=color.black, bgcolor=modeColor)
    table.cell(t, 1, 0, modeInput, text_color=color.black, bgcolor=modeColor)

    table.cell(t, 0, 1, "HTF Bias", text_color=color.white)
    htfText = not useHTF ? "OFF" : htfBullish ? "BULL" : "BEAR"
    htfColor = not useHTF ? color.gray : htfBullish ? color.green : color.red
    table.cell(t, 1, 1, htfText, text_color=htfColor)

    table.cell(t, 0, 2, "VWAP", text_color=color.white)
    vwapText = not useVWAP ? "OFF" : close > vwapVal ? "ABOVE" : "BELOW"
    vwapColor = not useVWAP ? color.gray : close > vwapVal ? color.green : color.red
    table.cell(t, 1, 2, vwapText, text_color=vwapColor)

    table.cell(t, 0, 3, "EMA Align", text_color=color.white)
    emaAlignText = not useEmaAlign ? "OFF" : ema5 > ema10 ? "BULL" : "BEAR"
    emaAlignColor = not useEmaAlign ? color.gray : ema5 > ema10 ? color.green : color.red
    table.cell(t, 1, 3, emaAlignText, text_color=emaAlignColor)

    table.cell(t, 0, 4, "RSI", text_color=color.white)
    rsiText = not useRSI ? "OFF" : str.tostring(rsi, "#")
    rsiColor = not useRSI ? color.gray : rsi > rsiLongEntry ? color.green : rsi < rsiShortEntry ? color.red : color.white
    table.cell(t, 1, 4, rsiText, text_color=rsiColor)

    table.cell(t, 0, 5, "Volume", text_color=color.white)
    volText = not useVolFilter ? "OFF" : volOK ? "OK" : "LOW"
    volColor = not useVolFilter ? color.gray : volOK ? color.green : color.red
    table.cell(t, 1, 5, volText, text_color=volColor)

    table.cell(t, 0, 6, "Session", text_color=color.white)
    sessText = not useSession ? "OFF" : inMorning ? "AM" : inAfternoon ? "PM" : "CLOSED"
    sessColor = not useSession ? color.gray : (inMorning or inAfternoon) ? color.green : color.red
    table.cell(t, 1, 6, sessText, text_color=sessColor)

    posVsCloud = close > cloudTop ? "ABOVE" : close < cloudBottom ? "BELOW" : "IN"
    cloudPosColor = close > cloudTop ? color.green : close < cloudBottom ? color.red : color.gray
    table.cell(t, 0, 7, "Cloud", text_color=color.white)
    table.cell(t, 1, 7, not useCloud ? "OFF" : posVsCloud, text_color=not useCloud ? color.gray : cloudPosColor)

    table.cell(t, 0, 8, "Chikou", text_color=color.white)
    chikouText = not useChikou ? "OFF" : chikouAbove ? "ABOVE" : "BELOW"
    chikouColor = not useChikou ? color.gray : chikouAbove ? color.green : color.red
    table.cell(t, 1, 8, chikouText, text_color=chikouColor)

    table.cell(t, 0, 9, "Exit", text_color=color.white)
    table.cell(t, 1, 9, useKijunTrail ? "KIJUN" : "FIXED", text_color=useKijunTrail ? color.yellow : color.aqua)

    table.cell(t, 0, 10, "SL/TP", text_color=color.white)
    table.cell(t, 1, 10, str.tostring(modeSL, "#") + "/" + str.tostring(modeTP, "#") + "t", text_color=color.aqua)

    table.cell(t, 0, 11, "Cooldown", text_color=color.white)
    table.cell(t, 1, 11, str.tostring(barsSinceExit) + "/" + str.tostring(cooldownBars), text_color=pastCooldown ? color.green : color.red)

    table.cell(t, 0, 12, "Lookback", text_color=color.white)
    table.cell(t, 1, 12, str.tostring(swingLen) + " bars", text_color=color.aqua)

    table.cell(t, 0, 13, "Capital", text_color=color.white)
    table.cell(t, 1, 13, "$" + str.tostring(strategy.equity, "#,###"), text_color=strategy.equity >= 100000 ? color.green : color.red)
